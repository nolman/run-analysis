<div class="cooldown-marker" style={{this.styleAttributes}} aria-label={{this.ariaLabel}}>
  <span class="cooldown-marker-stack" style={{this.stackStyle}}>
    {{#each this.cooldowns as |cooldown|}}
      <span class="cooldown-marker-segment" style={{cooldown.classColorStyle}}></span>
    {{/each}}
  </span>

  <EmberPopover
    @delay={{100}}
    @popperContainer="body"
    @popperOptions={{this.popperOptions}}
    @side="top"
    @spacing={{0}}
  >
    <div class="cooldown-popover">
      <div class="cooldown-popover-heading">
        <h3>{{this.heading}}</h3>
        <span>{{this.useLabel}}</span>
      </div>

      <div class="cooldown-popover-list">
        {{#each this.cooldowns as |cooldown|}}
          <div class="cooldown-popover-row">
            <span class="cooldown-class-swatch" style={{cooldown.classColorStyle}}></span>
            <div class="cooldown-popover-detail">
              <strong>{{cooldown.sourceName}}</strong>
              <span>{{cooldown.name}}</span>
            </div>
            <time>{{cooldown.formattedTime}}</time>
          </div>
        {{/each}}
      </div>
    </div>
  </EmberPopover>
</div>
