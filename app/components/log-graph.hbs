<div class="run-row">
  <div class="run-label">
    <div>
      <input
        aria-label="Run name"
        class="run-title-input"
        title="Click to rename run"
        type="text"
        value={{@log.title}}
        {{on "change" this.commitRunName}}
        {{on "keydown" this.handleRunNameKeydown}}
      />
      <a class="run-id" href={{this.reportUrl}} target="_blank" rel="noopener noreferrer">{{@key}}</a>
    </div>

    <div class="run-actions">
      <button class="icon-button" type="button" disabled={{eq this.startOffset 0}} {{on "click" this.resetOffset}} title="Reset start">
        <FaIcon @icon="redo" />
      </button>
      <button class="icon-button danger" type="button" {{on "click" @removeLog}} title="Remove run">
        <FaIcon @icon="trash" />
      </button>
    </div>
  </div>

  <div class="timeline-viewport" {{on "mouseenter" this.measureGraphWidth}} {{on "focusin" this.measureGraphWidth}}>
    <div id={{this.graphElementId}} class="log-graph" style={{this.timelineStyle}}>
      {{#each @log.fights as |fight|}}
        <Fight
          @fight={{fight}}
          @startOffset={{this.startOffset}}
          @setStartOffset={{this.setStartOffset}}
          @timelineLength={{@maxRaidLength}}
        />
      {{/each}}

      {{#if @showCooldowns}}
        {{#each this.cooldownGroups as |cooldownGroup|}}
          <CooldownMarker
            @cooldownGroup={{cooldownGroup}}
            @timelineLength={{@maxRaidLength}}
          />
        {{/each}}
      {{/if}}
    </div>
  </div>
</div>
