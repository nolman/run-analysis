<main class="app-shell">
  <header class="app-toolbar">
    <div class="app-title-group">
      <h1>Run Analysis</h1>
      <div class="toolbar-meta">{{this.runCountLabel}}</div>
    </div>

    <div class="toolbar-controls">
      <label class="checkbox-control">
        <Input
          @checked={{this.showCooldowns}}
          @type="checkbox"
        />
        <span>Show cooldowns</span>
      </label>

      <form class="search-box" {{on "submit" this.addLog}}>
        <Input
          @value={{this.newLogId}}
          aria-label="Warcraft Logs report ID"
          class="form-control"
          placeholder="Warcraft Logs report ID"
          type="text"
        />
        <button class="primary-button" type="submit">
          <FaIcon @icon="plus" />
          <span>Import</span>
        </button>
      </form>
    </div>
  </header>

  {{#if this.hasRuns}}
    <section class="summary-strip" aria-label="Run summary">
      <div class="metric">
        <span class="metric-label">Fastest</span>
        <strong>{{this.formattedFastestRaidLength}}</strong>
      </div>
      <div class="metric">
        <span class="metric-label">Slowest</span>
        <strong>{{this.formattedSlowestRaidLength}}</strong>
      </div>
      <div class="metric">
        <span class="metric-label">Spread</span>
        <strong>{{this.formattedRaidSpread}}</strong>
      </div>
    </section>
  {{/if}}

  <section class="analysis-container">
    <div class="timeline-shell">
      {{#each this.summaryRuns as |run|}}
        <LogGraph
          @key={{run.logId}}
          @log={{run}}
          @cooldowns={{run.cooldowns}}
          @maxRaidLength={{this.maxRaidLength}}
          @msPerPixel={{this.msPerPixel}}
          @showCooldowns={{this.showCooldowns}}
          @startOffset={{run.startOffset}}
          @setStartOffset={{fn this.setStartOffset run.logId}}
          @removeLog={{fn this.removeLog run.logId}}
        />
      {{else}}
        <div class="landing">
          <h2>No runs loaded</h2>
        </div>
      {{/each}}

      {{#if this.hasRuns}}
        <div class="scale-row">
          <div class="scale-label">Time</div>
          <div class="timeline-viewport">
            <GraphScale @msPerPixel={{this.msPerPixel}} @maxLength={{this.maxRaidLength}} />
          </div>
        </div>
      {{/if}}
    </div>
  </section>

  {{#if this.hasBreakdownRows}}
    <section class="breakdown-section">
      <h2>Run Breakdown</h2>
      <div class="breakdown-table-wrap">
        <table class="breakdown-table">
          <thead>
            <tr>
              <th scope="col">Segment</th>
              {{#each this.summaryRuns as |run|}}
                <th scope="col">{{run.title}}</th>
              {{/each}}
            </tr>
          </thead>
          <tbody>
            {{#each this.breakdownRows as |row|}}
              <tr class="breakdown-row {{row.className}}">
                <th scope="row">
                  <span class="breakdown-label">{{row.label}}</span>
                </th>
                {{#each row.cells as |cell|}}
                  <td class={{if cell.missing "is-missing"}}>
                    <span class="breakdown-duration">{{cell.formattedDuration}}</span>
                    {{#if cell.formattedDelta}}
                      <span class="breakdown-delta {{cell.deltaClass}}">{{cell.formattedDelta}}</span>
                    {{/if}}
                  </td>
                {{/each}}
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  {{/if}}

  {{#if this.hasCooldownRows}}
    <section class="cooldown-section">
      <h2>Cooldowns</h2>
      <div class="breakdown-table-wrap">
        <table class="breakdown-table cooldown-table">
          <thead>
            <tr>
              <th scope="col">Cooldown</th>
              {{#each this.summaryRuns as |run|}}
                <th scope="col">{{run.title}}</th>
              {{/each}}
            </tr>
          </thead>
          <tbody>
            {{#each this.cooldownRows as |row|}}
              <tr>
                <th scope="row">
                  <span class="breakdown-label">{{row.label}}</span>
                </th>
                {{#each row.cells as |cell|}}
                  <td class={{if cell.isEmpty "is-missing"}}>
                    {{#if cell.isEmpty}}
                      <span class="cooldown-empty">-</span>
                    {{else}}
                      <span class="cooldown-uses">{{cell.formattedUses}}</span>
                      {{#each cell.players as |player|}}
                        <span class="cooldown-player">
                          <span class="cooldown-class-swatch cooldown-player-swatch" style={{player.classColorStyle}}></span>
                          <span class="cooldown-player-detail">
                            <strong>{{player.name}}</strong>
                            <span>{{player.formattedUses}} at {{player.formattedTimes}}</span>
                          </span>
                        </span>
                      {{/each}}
                    {{/if}}
                  </td>
                {{/each}}
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  {{/if}}
</main>
